server {
    listen 80;
    server_name your_domain_or_ip;

    root /var/www/html;
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock;
    }

    location ~ \.db$ {
        deny all;
    }

    location ~* \.(css|ico)$ {
        expires 7d;
    }
}
